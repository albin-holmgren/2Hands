---
import { getHomeCopy } from "../i18n/home";
import type { HomeCopy } from "../i18n/home";
import {
  DEFAULT_LOCALE,
  localeHashPath,
  localeHomePath,
  type Locale,
} from "../i18n/locales";
import { APP_URL } from "../site";
import Button from "./Button.astro";
import Logo from "./Logo.astro";

type Props = {
  starsLabel: string;
  locale?: Locale;
  copy?: HomeCopy["nav"];
  homeHref?: string;
};

const locale = Astro.props.locale ?? DEFAULT_LOCALE;
const copy = Astro.props.copy ?? getHomeCopy(locale).nav;
const homeHref = Astro.props.homeHref ?? localeHomePath(locale);

const labels = {
  en: { why: "Why 2hands", pricing: "Pricing", open: "Open app", menu: "Menu" },
  de: { why: "Warum 2hands", pricing: "Preise", open: "App öffnen", menu: "Menü" },
  ko: { why: "2hands 소개", pricing: "요금제", open: "앱 열기", menu: "메뉴" },
}[locale];
const NAV_LINKS = [
  { href: localeHashPath(locale, "demo"), label: copy.product },
  { href: localeHashPath(locale, "roster"), label: labels.why },
  { href: localeHashPath(locale, "pricing"), label: labels.pricing },
  { href: localeHashPath(locale, "selfhost"), label: copy.openSource },
];

---

<header class="site-header">
  <div class="site-header__left">
    <Logo href={homeHref} />
    <nav class="site-nav" aria-label={copy.primary}>
      {
        NAV_LINKS.map((link) => (
          <a href={link.href} >
            {link.label}
          </a>
        ))
      }
    </nav>
  </div>
  <div class="site-header__right">
    <div class="site-header__cta">
      <Button href={`${APP_URL}/sign-in`} size="sm">{labels.open}<span aria-hidden="true">↗</span></Button>
    </div>
    <details class="site-menu" data-site-menu>
      <summary class="site-menu__toggle" aria-label={copy.menu}>
        <svg class="site-menu__icon site-menu__icon--open" viewBox="0 0 20 20" aria-hidden="true">
          <path d="M3 6h14M3 10h14M3 14h14" />
        </svg>
        <svg class="site-menu__icon site-menu__icon--close" viewBox="0 0 20 20" aria-hidden="true">
          <path d="M5 5l10 10M15 5L5 15" />
        </svg>
      </summary>
      <nav class="site-menu__panel" aria-label={copy.primary}>
        {
          NAV_LINKS.map((link) => (
            <a href={link.href} >
              {link.label}
            </a>
          ))
        }
      </nav>
    </details>
  </div>
</header>

<script>
  const menu = document.querySelector<HTMLDetailsElement>("[data-site-menu]");

  if (menu) {
    menu.addEventListener("click", (event) => {
      if ((event.target as HTMLElement).closest("a")) menu.open = false;
    });

    document.addEventListener("click", (event) => {
      if (menu.open && !menu.contains(event.target as Node)) menu.open = false;
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && menu.open) {
        menu.open = false;
        menu.querySelector<HTMLElement>("summary")?.focus();
      }
    });
  }
</script>
