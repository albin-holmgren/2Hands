---
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import Button from "./Button.astro";
import Pricing from "./Pricing.astro";
import { HeroComposer } from "./HeroComposer";
import { WorkspacePreview } from "./WorkspacePreview";
import { getHomeCopy } from "../i18n/home";
import { getLandingCopy } from "../i18n/landing";
import { DEFAULT_LOCALE, isLocale, localeHomePath, type Locale } from "../i18n/locales";
import BaseLayout from "../layouts/BaseLayout.astro";
import { DOCS_URL, GITHUB_URL, SITE_NAME, SITE_URL } from "../site";
import "../styles/landing.css";

const locale: Locale = isLocale(Astro.currentLocale) ? Astro.currentLocale : DEFAULT_LOCALE;
const copy = getLandingCopy(locale);
const shared = getHomeCopy(locale);
const homeHref = localeHomePath(locale);
const previewHeading = {
  en: "One place. A little more possible.",
  de: "Ein Ort. Ein bisschen mehr möglich.",
  ko: "하나의 공간, 더 많은 가능성.",
}[locale];
const structuredData = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: SITE_NAME,
  url: SITE_URL,
  description: copy.description,
  applicationCategory: "ProductivityApplication",
  operatingSystem: "Web, macOS, Windows, iOS, Android",
  codeRepository: GITHUB_URL,
  license: `${GITHUB_URL}/blob/main/LICENSE`,
  isAccessibleForFree: true,
};
---

<BaseLayout title="2hands — A little help. A lot more possible." description={copy.description} {locale} {structuredData} skipLabel={shared.skipToContent} homeAlternates>
  <div class="landing">
    <div class="landing-container">
      <Header {locale} copy={shared.nav} starsLabel="" {homeHref} />
    </div>
    <main id="main">
      <section class="landing-hero" aria-labelledby="hero-heading">
        <div class="landing-hero__glow" aria-hidden="true"></div>
        <div class="landing-hero__content">
          <p class="landing-eyebrow">{copy.eyebrow}</p>
          <h1 id="hero-heading">{copy.heading}<br /><em>{copy.headingAccent}</em></h1>
          <p class="landing-hero__description">{copy.description}</p>
          <HeroComposer client:load />
          <div class="landing-hero__links">
            <a href="#demo">{copy.explore}<span aria-hidden="true">↓</span></a>
            <span aria-hidden="true">·</span>
            <a href={DOCS_URL} target="_blank" rel="noreferrer">{copy.selfHost}<span aria-hidden="true">↗</span></a>
          </div>
        </div>
      </section>

      <div class="landing-container">
        <section class="landing-models" aria-labelledby="models-heading">
          <p id="models-heading">{copy.modelsLabel}</p>
          <div class="landing-models__names" aria-label="Examples of compatible model families">
            <span>Claude</span><span>GPT</span><span>Gemini</span><span>Grok</span>
            <span class="landing-models__own">BYOK <span aria-hidden="true">↗</span></span>
          </div>
          <p class="landing-models__note">{copy.modelsNote}</p>
        </section>

        <section id="demo" class="landing-preview" aria-label="Interactive product preview">
          <div class="landing-preview__intro"><h2>{previewHeading}</h2><p>{copy.previewHint}</p></div>
          <WorkspacePreview client:load />
        </section>

        <section id="roster" class="landing-section">
          <div class="landing-section__intro">
            <div><p class="landing-eyebrow">{copy.featureEyebrow}</p><h2>{copy.featureHeading}</h2></div>
            <p class="landing-section__description">{copy.featureDescription}</p>
          </div>
          <div class="landing-features">
            <article class="landing-feature">
              <div class="landing-feature__copy"><span class="landing-feature__number">01</span><h3>{copy.features[0]?.title}</h3><p>{copy.features[0]?.body}</p></div>
              <div class="feature-scene feature-scene--spaces" aria-hidden="true">
                <div class="mini-spaces">
                  {copy.workspaceNames.map((name, index) => <div class:list={["mini-space", index === 0 && "mini-space--active"]}>
                    <span class={`mini-space__icon mini-space__icon--${index}`}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 7V5h7l2 2h9v12H3V7Z" /></svg></span>
                    <div><b>{name}</b><span>{copy.workspaceMeta[index]}</span></div><span class="mini-space__tick">{index === 0 ? "✓" : ""}</span>
                  </div>)}
                </div>
              </div>
            </article>
            <article class="landing-feature">
              <div class="landing-feature__copy"><span class="landing-feature__number">02</span><h3>{copy.features[1]?.title}</h3><p>{copy.features[1]?.body}</p></div>
              <div class="feature-scene feature-scene--models" aria-hidden="true">
                <div class="mini-models">
                  <div class="mini-model"><span class="mini-model__initial">C</span><b>Claude</b><span>↗</span></div>
                  <div class="mini-model mini-model--selected"><span class="mini-model__initial">G</span><b>GPT</b><span>✓</span></div>
                  <div class="mini-model"><span class="mini-model__initial">G</span><b>Gemini</b><span>↗</span></div>
                </div>
              </div>
            </article>
            <article class="landing-feature">
              <div class="landing-feature__copy"><span class="landing-feature__number">03</span><h3>{copy.features[2]?.title}</h3><p>{copy.features[2]?.body}</p></div>
              <div class="feature-scene feature-scene--routines" aria-hidden="true">
                <div class="mini-routine">
                  <div class="mini-routine__heading"><span>↻</span><div><b>{copy.routineTitle}</b><small>{copy.routineTime}</small></div></div>
                  {copy.routineRows.map((row, index) => <div class="mini-routine__row"><span>{index === 2 ? "↗" : "✓"}</span>{row}</div>)}
                </div>
              </div>
            </article>
          </div>
        </section>

        <section class="landing-control">
          <div class="landing-control__copy">
            <p class="landing-eyebrow">{copy.controlEyebrow}</p><h2>{copy.controlHeading}</h2>
            <p>{copy.controlDescription}</p>
            <a class="landing-text-link" href="#demo">{copy.controlLink}<span aria-hidden="true">↗</span></a>
          </div>
          <div class="landing-control__visual" aria-hidden="true">
            <div class="momentum-card">
              <div class="momentum-card__symbol"><img src="/brand/twohands-mark.svg" width="25" height="25" alt="" /></div>
              <h3>{copy.controlCardTitle}</h3><p>{copy.controlCardSubtitle}</p>
              <div class="momentum-card__list">{copy.controlTasks.map((task, index) => <div><span>{index === 2 ? "↗" : "✓"}</span>{task}</div>)}</div>
              <div class="momentum-card__progress"><span></span></div>
            </div>
          </div>
          <div class="landing-control__tags">{copy.controlTags.map((tag) => <span>{tag}</span>)}</div>
        </section>

        <Pricing {locale} />

        <section class="landing-faq" aria-labelledby="faq-title">
          <div><p class="landing-eyebrow">{copy.faqEyebrow}</p><h2 id="faq-title">{copy.faqHeading}</h2></div>
          <div class="landing-faq__items">{copy.questions.map((item) => <details><summary>{item.question}<span aria-hidden="true">+</span></summary><p>{item.answer}</p></details>)}</div>
        </section>
      </div>

      <section id="selfhost" class="landing-closing">
        <div class="landing-container">
          <p class="landing-eyebrow">{copy.closingEyebrow}</p><h2>{copy.closingHeading}</h2>
          <p class="landing-closing__description">{copy.closingDescription}</p>
          <div class="landing-actions">
            <Button href={DOCS_URL} external>{copy.selfHost}<span aria-hidden="true">↗</span></Button>
            <a href={GITHUB_URL} class="landing-text-link" target="_blank" rel="noreferrer">{copy.viewSource}<span aria-hidden="true">↗</span></a>
          </div><p class="landing-closing__license">{copy.license}</p>
        </div>
      </section>
    </main>
    <div class="landing-container"><Footer {locale} {homeHref} languagesLabel={shared.footer.languagesLabel} navLabel={shared.footer.navLabel} /></div>
  </div>
</BaseLayout>
