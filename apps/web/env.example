# ============================================
# 2HANDS ENVIRONMENT CONFIGURATION
# ============================================
# Copy this file to .env.local and fill in the values
# NEVER commit .env.local to version control!

# ============================================
# DATABASE & AUTH (CRITICAL - App won't start without these)
# ============================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ============================================
# AI SERVICE (CRITICAL - Core functionality)
# ============================================
ANTHROPIC_API_KEY=sk-ant-api03-...

# ============================================
# PAYMENT PROCESSING (CRITICAL - Billing won't work)
# ============================================
# Use sk_test_ keys for development, sk_live_ for production
STRIPE_SECRET_KEY=sk_test_51...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_51...

# Stripe Price IDs (get these from Stripe Dashboard > Products)
# Subscriptions - Monthly
STRIPE_PRICE_STARTER_MONTHLY=price_...
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_BUSINESS_MONTHLY=price_...

# Subscriptions - Yearly
STRIPE_PRICE_STARTER_YEARLY=price_...
STRIPE_PRICE_PRO_YEARLY=price_...
STRIPE_PRICE_BUSINESS_YEARLY=price_...

# Credit Packs (one-time purchases)
STRIPE_PRICE_CREDITS_SMALL=price_...
STRIPE_PRICE_CREDITS_MEDIUM=price_...
STRIPE_PRICE_CREDITS_LARGE=price_...
STRIPE_PRICE_CREDITS_XLARGE=price_...

# ============================================
# VM INFRASTRUCTURE (Required for agent browser automation)
# ============================================
# Paperspace API for GPU VM provisioning
PAPERSPACE_API_KEY=ps_key_...
PAPERSPACE_PROJECT_ID=pr_...

# Shared VM fallback (for development/local testing)
# A VM running the @2hands/vm-server on port 8080
SHARED_VM_IP=127.0.0.1

# VM Security (generate with: openssl rand -hex 32)
# Must match VM_SECRET on all provisioned VMs
VM_SECRET=generate_a_64_character_hex_string_here

# ============================================
# SECURITY (CRITICAL - Required for secure operation)
# ============================================
# Generate with: openssl rand -hex 32
INTERNAL_API_SECRET=generate_a_64_character_hex_string_here
CRON_SECRET=generate_another_64_character_hex_string

# ============================================
# RATE LIMITING (Recommended for production)
# ============================================
# Get from https://upstash.com (free tier available)
UPSTASH_REDIS_URL=https://...upstash.io
UPSTASH_REDIS_TOKEN=...

# ============================================
# APP CONFIGURATION
# ============================================
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================
# TESTING (Optional - for Playwright e2e tests)
# ============================================
TEST_USER_EMAIL=test@example.com
TEST_USER_PASSWORD=secure_test_password

# ============================================
# OPTIONAL SERVICES
# ============================================
# Email service (for production notifications)
# SENDGRID_API_KEY=SG....

# OpenAI (for Supabase Studio AI features)
# OPENAI_API_KEY=sk-...
