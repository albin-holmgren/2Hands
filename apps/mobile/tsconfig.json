{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "skipLibCheck": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@2hands/types": [
        "../../packages/types/src"
      ],
      "@2hands/api-client": [
        "../../packages/api-client/src"
      ],
      "@2hands/tailwind-config": [
        "../../packages/tailwind-config/src"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "nativewind-env.d.ts"
  ]
}