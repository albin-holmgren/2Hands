# ============================================
# 2HANDS ENVIRONMENT CONFIGURATION
# ============================================
# Copy this file to .env.local and fill in the values
# NEVER commit .env.local to version control!

# ============================================
# DATABASE & AUTH (CRITICAL - App won't start without these)
# ============================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ============================================
# AI SERVICE (CRITICAL - Core functionality)
# ============================================
ANTHROPIC_API_KEY=sk-ant-api03-...

# ============================================
# PAYMENT PROCESSING (CRITICAL - Billing won't work)
# ============================================
# Use sk_test_ keys for development, sk_live_ for production
STRIPE_SECRET_KEY=sk_test_51...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_51...

# Stripe Price IDs (get these from Stripe Dashboard > Products)
# Subscriptions - Monthly
STRIPE_PRICE_STARTER_MONTHLY=price_...
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_BUSINESS_MONTHLY=price_...

# Subscriptions - Yearly
STRIPE_PRICE_STARTER_YEARLY=price_...
STRIPE_PRICE_PRO_YEARLY=price_...
STRIPE_PRICE_BUSINESS_YEARLY=price_...

# Credit Packs (one-time purchases)
STRIPE_PRICE_CREDITS_SMALL=price_...
STRIPE_PRICE_CREDITS_MEDIUM=price_...
STRIPE_PRICE_CREDITS_LARGE=price_...
STRIPE_PRICE_CREDITS_XLARGE=price_...

# ============================================
# INFRASTRUCTURE (Required for agent provisioning)
# ============================================
# Shared VM IP address for agent computer-use (no hardcoded fallback)
SHARED_VM_IP=your.vm.ip.address

# DigitalOcean API token with VM management permissions (optional)
# DIGITALOCEAN_API_TOKEN=dop_v1_...

# ============================================
# SECURITY (CRITICAL - Required for secure operation)
# ============================================
# Generate with: openssl rand -hex 32
INTERNAL_API_SECRET=generate_a_64_character_hex_string_here
CRON_SECRET=generate_another_64_character_hex_string

# Encryption key for stored credentials (AES-256-GCM)
# Generate with: openssl rand -hex 32
CREDENTIAL_ENCRYPTION_KEY=generate_a_64_character_hex_string_for_credentials

# ============================================
# V3 SECRET BROKER (Slice 3 — protected secrets + browser login)
# ============================================
# Master key for envelope encryption of protected secrets and browser
# contexts (private.protected_secrets / private.browser_contexts).
# Generate with: openssl rand -hex 32
# WARNING: DEV ONLY — an env-backed master key is for local development.
# Production must wrap the master key with KMS/HSM (SECRET_BROKER_KMS_KEY_ID).
# Rotating/losing this key orphans every stored secret.
SECRET_BROKER_MASTER_KEY=generate_a_64_character_hex_string_here
# Key id recorded on each envelope so rotations can be tracked.
SECRET_BROKER_KEY_ID=env-dev-key

# HMAC key that signs one-time secret-injection leases (trusted injector).
# Generate with: openssl rand -hex 32
# WARNING: DEV ONLY as an env var; production keeps this in KMS as well.
SECRET_LEASE_SIGNING_KEY=generate_a_64_character_hex_string_here

# Demo Account Provider fixture password (deterministic fake provider used by
# CI and the golden path — NOT a real credential; default is a published
# fixture value). Override to rotate in CI.
DEMO_PROVIDER_PASSWORD=demo-password-fixture

# ============================================
# RATE LIMITING (Recommended for production)
# ============================================
# Get from https://upstash.com (free tier available)
UPSTASH_REDIS_URL=https://...upstash.io
UPSTASH_REDIS_TOKEN=...

# ============================================
# APP CONFIGURATION
# ============================================
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================
# TESTING (Optional - for Playwright e2e tests)
# ============================================
TEST_USER_EMAIL=test@example.com
TEST_USER_PASSWORD=secure_test_password

# ============================================
# OPTIONAL SERVICES
# ============================================
# Email service (for production notifications)
# SENDGRID_API_KEY=SG....

# OpenAI (for Supabase Studio AI features)
# OPENAI_API_KEY=sk-...

# ============================================
# V3 — MANAGED COMPUTER & RUNNER
# ============================================
# Provider for the managed 2Hands Computer.
#   fixture      — filesystem-backed deterministic provider (dev/CI, no Docker)
#   local-docker — Docker-isolated sessions (dev/CI/self-host; needs Docker)
#   vercel-sandbox — hosted adapter (later; behind FEATURE_HOSTED_SANDBOX)
COMPUTER_PROVIDER=fixture
COMPUTER_ENABLED=true
COMPUTER_IMAGE=node:20-bookworm-slim
COMPUTER_MAX_SESSION_MS=900000
# HMAC key signing runner job leases. Generate: openssl rand -hex 32
RUNNER_LEASE_SIGNING_KEY=generate_a_64_character_hex_string_here

# ============================================
# V3 — BROWSER PROVIDER (Account Broker)
# ============================================
#   local-playwright — deterministic local provider (dev/CI)
#   browserbase      — hosted provider (requires keys + reviewed manifests)
BROWSER_PROVIDER=local-playwright
# BROWSERBASE_API_KEY=
# BROWSERBASE_PROJECT_ID=
# Recording of authentication browser sessions is architecturally disabled.
BROWSER_AUTH_RECORDING=false

# ============================================
# V3 — FEATURE FLAGS (default off; enable per environment)
# ============================================
FEATURE_REALTIME_VOICE=false
FEATURE_HOSTED_SANDBOX=false
FEATURE_REAL_BROWSER_LOGIN=false
FEATURE_REAL_AGENTS=false

# ============================================
# V3 — GITHUB APP (real publication path; demo works without)
# ============================================
# GITHUB_APP_ID=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_PRIVATE_KEY=

# ============================================
# V3 — PLANS (weekly work credits; server-side config)
# ============================================
# Stripe price ids for the v3 plan hypothesis (Pro $20 / Pro 5x $100 / Pro 20x $200)
# STRIPE_PRICE_PRO_V3_MONTHLY=price_...
# STRIPE_PRICE_PRO_5X_MONTHLY=price_...
# STRIPE_PRICE_PRO_20X_MONTHLY=price_...

# ============================================
# V3 — EMBEDDINGS (memory retrieval; optional — FTS-only without it)
# ============================================
# EMBEDDINGS_PROVIDER=openai
# EMBEDDINGS_MODEL=text-embedding-3-small
