# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
package-lock.json

# testing
coverage/
playwright-report/
test-results/

# next.js
.next/
out/

# production
build/
dist/
!.eas/build/

# turbo
.turbo/

# expo
.expo/
ios/
android/
*.ipa
*.apk
*.aab

# xcode
*.xcworkspace
*.xcodeproj
xcodebuild.log
Pods/
Podfile.lock

# misc
.DS_Store
*.pem
Thumbs.db

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — NEVER commit secrets
.env
.env.*
!.env.example
!.env.*.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# editor
.idea/
.vscode/
*.swp
*.swo
.env*.local
.env*
